{
  "schema_version": 1,
  "id": "__default_botanypotstiers_ultra_dyed_terracotta_waxed_pots",
  "name": {
    "translate": "collapsible_groups.group.__default_botanypotstiers_ultra_dyed_terracotta_waxed_pots",
    "fallback": "Ultra Colored Terracotta Waxed Botany Pots"
  },
  "enabled": true,
  "filter": {
    "all": [
      {
        "type": "item",
        "namespace": "botanypotstiers"
      },
      {
        "item_path_starts_with": "ultra_"
      },
      {
        "item_path_ends_with": "_terracotta_waxed_botany_pot"
      },
      {
        "not": {
          "any": [
            {
              "type": "item",
              "id": "botanypotstiers:ultra_terracotta_waxed_botany_pot"
            },
            {
              "item_path_ends_with": "_glazed_terracotta_waxed_botany_pot"
            }
          ]
        }
      }
    ]
  }
}
