{
  "schema_version": 1,
  "id": "__default_botanypotstiers_creative_dyed_terracotta_normal_pots",
  "name": {
    "translate": "collapsible_groups.group.__default_botanypotstiers_creative_dyed_terracotta_normal_pots",
    "fallback": "Creative Colored Terracotta Botany Pots"
  },
  "enabled": true,
  "filter": {
    "all": [
      {
        "type": "item",
        "namespace": "botanypotstiers"
      },
      {
        "item_path_starts_with": "creative_"
      },
      {
        "item_path_ends_with": "_terracotta_botany_pot"
      },
      {
        "not": {
          "any": [
            {
              "type": "item",
              "id": "botanypotstiers:creative_terracotta_botany_pot"
            },
            {
              "item_path_ends_with": "_glazed_terracotta_botany_pot"
            }
          ]
        }
      }
    ]
  }
}
