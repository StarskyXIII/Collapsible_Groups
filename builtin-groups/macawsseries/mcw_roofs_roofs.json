              "all": [
                {
                  "type": "item",
                  "namespace": "mcwroofs"
                },
                {
                  "item_path_ends_with": "_upper_lower_roof"
                }
              ]
            },
            {
              "all": [
                {
                  "type": "item",
                  "namespace": "mcwroofs"
                },
                {
                  "item_path_ends_with": "_upper_steep_roof"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
